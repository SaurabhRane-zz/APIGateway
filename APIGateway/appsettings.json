{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "EnableJwtAuthentication": true,
    "EnableApiKeyAuthentication": true,
    "EnableWindowsAuthentication": false,
    "EnableRateLimiting": true,
    "EnableCircuitBreaker": true,
    "EnableCaching": true,
    "EnableServiceDiscovery": true,
    "EnableOpenTelemetry": true,
    "EnableApiVersioning": true,
    "EnableDeveloperPortal": true,
    "EnableMessageSecurity": true,
    "EnableGovernance": true,
    "EnableCloudNative": true
  },
  "Jwt": {
    "Issuer": "APIGateway",
    "Audience": "APIConsumers",
    "Key": "YourSuperSecretKeyForJwtTokenGeneration12345",
    "ExpiryMinutes": 60
  },
  "ApiKey": {
    "HeaderName": "X-API-Key",
    "Keys": {
      "client1": "api-key-client1-12345",
      "client2": "api-key-client2-67890"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1d",
        "Limit": 1000
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-For",
            "Append": "{RemoteIpAddress}"
          }
        ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://api1.example.com"
          },
          "destination2": {
            "Address": "https://api2.example.com"
          }
        },
        "LoadBalancing": {
          "Policy": "RoundRobin"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "SamplingDuration": "00:00:30",
    "MinimumThroughput": 10,
    "BreakDuration": "00:00:30"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Consul": {
    "Address": "http://localhost:8500",
    "ServiceName": "apigateway",
    "ServiceAddress": "localhost",
    "ServicePort": 5000
  },
  "Jaeger": {
    "Host": "localhost",
    "Port": "6831"
  },
  "Vault": {
    "Address": "http://localhost:8200",
    "Token": "your-vault-token",
    "Path": "secret/apigateway"
  }
}